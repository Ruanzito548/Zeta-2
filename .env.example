# Firebase Configuration
# Get these values from your Firebase Console: https://console.firebase.google.com/
# Example values for Zeta-2 project (replace with your own):

# Client-side Firebase configuration (exposed to browser)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBhQKuXx9Ev0yueZ7w3JEbD80yE1gwIPoo
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=zeta-2.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=zeta-2
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=zeta-2.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=286668624287
NEXT_PUBLIC_FIREBASE_APP_ID=1:286668624287:web:76833495efe44777dfedaa

# Server-side Firebase Admin SDK (never expose to client)
# Download JSON key from Firebase Console > Project Settings > Service Accounts
# Format: {"type":"service_account","project_id":"...","private_key":"..."}
FIREBASE_ADMIN_SDK_KEY=your_admin_sdk_json_here

# Firebase Emulator Suite (for local development)
# Download Firebase CLI: npm install -g firebase-tools
# Start emulator: firebase emulators:start
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
NEXT_PUBLIC_AUTH_EMULATOR_HOST=localhost:9099
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=localhost:8080

# Application Settings
NEXT_PUBLIC_APP_NAME=Zeta 2
NEXT_PUBLIC_APP_VERSION=1.0.0
NODE_ENV=development
